// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  RESTAURANT
  NGO
  RECYCLER
  ADMIN
}

enum OrganizationType {
  RESTAURANT
  NGO
  RECYCLER
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum FoodDonationStatus {
  AVAILABLE
  RESERVED
  APPROVED
  PICKED_UP
  COLLECTED
  EXPIRED
  CANCELLED
  COMPLETED
  RECOVERY_PENDING
  RECOVERED
}

enum RecoveryMethod {
  CATTLE_FEED
  COMPOST
  BIOGAS
  ORGANIC_FERTILIZER
  ANIMAL_SHELTER
  SAFE_DISPOSAL
}

enum FoodType {
  COOKED
  PACKAGED
  RAW
  BAKERY
  BEVERAGE
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  REJECTED
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique @db.VarChar(191)
  passwordHash       String         @db.VarChar(255)
  firstName          String         @db.VarChar(100)
  lastName           String         @db.VarChar(100)
  phone              String?        @db.VarChar(30)
  role               UserRole
  profileImageUrl    String?        @db.VarChar(2048)
  isActive           Boolean        @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  organizationId        String?
  organization          Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedOrganizations Organization[] @relation("OrganizationVerifiedBy")
  rejectedOrganizations Organization[] @relation("OrganizationRejectedBy")
  refreshTokens         RefreshToken[]
  reservations          Reservation[]
  recoveredDonations    FoodDonation[] @relation("DonationRecoveredBy")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([organizationId])
  @@index([role, isActive])
  @@index([deletedAt])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String               @db.VarChar(191)
  type               OrganizationType
  description        String?              @db.Text
  logoImageUrl       String?              @db.VarChar(2048)
  websiteUrl         String?              @db.VarChar(2048)
  registrationNumber String?              @db.VarChar(100)
  email              String?              @db.VarChar(191)
  phone              String?              @db.VarChar(30)
  verificationStatus VerificationStatus   @default(PENDING)
  rejectionReason    String?              @db.Text
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                @relation("OrganizationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedAt         DateTime?
  rejectedById       String?
  rejectedBy         User?                @relation("OrganizationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  isActive           Boolean              @default(true)
  deletedAt          DateTime?
  users              User[]
  locations          OrganizationLocation[]
  donations          FoodDonation[]
  reservations       Reservation[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([type, verificationStatus, isActive])
  @@index([email])
  @@index([deletedAt])
}

model OrganizationLocation {
  id             String       @id @default(cuid())
  organizationId String
  label          String       @db.VarChar(100)
  addressLine1   String       @db.VarChar(191)
  addressLine2   String?      @db.VarChar(191)
  city           String       @db.VarChar(100)
  state          String?      @db.VarChar(100)
  postalCode     String?      @db.VarChar(30)
  countryCode    String       @db.Char(2)
  latitude       Decimal      @db.Decimal(10, 7)
  longitude      Decimal      @db.Decimal(10, 7)
  googleMapsUrl  String?      @db.VarChar(2048)
  timezone       String       @default("UTC") @db.VarChar(100)
  isPrimary      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, label])
  @@index([organizationId, isPrimary])
  @@index([latitude, longitude])
  @@index([deletedAt])
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.VarChar(255)
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  tokenFamily String    @db.VarChar(100)
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, tokenFamily])
  @@index([expiresAt])
}

model FoodDonation {
  id                  String             @id @default(cuid())
  restaurantId        String
  restaurant          Organization       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  title               String             @db.VarChar(191)
  description         String?            @db.Text
  quantity            Decimal            @db.Decimal(10, 2)
  quantityUnit        String             @db.VarChar(50)
  foodType            FoodType
  mealType            String?            @db.VarChar(50)
  packagingType       String?            @db.VarChar(100)
  isVegetarian        Boolean            @default(false)
  isVegan             Boolean            @default(false)
  cookedAt            DateTime?
  expiresAt           DateTime
  pickupAddress       String?            @db.Text
  latitude            Decimal?           @db.Decimal(10, 7)
  longitude           Decimal?           @db.Decimal(10, 7)
  estimatedServings   Int?
  specialInstructions String?            @db.Text
  images              Json?
  status              FoodDonationStatus @default(AVAILABLE)
  recoveryMethod      RecoveryMethod?
  recoveryNotes       String?            @db.Text
  recoveredAt         DateTime?
  recoveredById       String?
  recoveredBy         User?              @relation("DonationRecoveredBy", fields: [recoveredById], references: [id], onDelete: SetNull)
  reservations        Reservation[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@index([restaurantId])
  @@index([status, expiresAt])
  @@index([foodType, status])
  @@index([latitude, longitude])
  @@index([deletedAt])
}

model Reservation {
  id                          String            @id @default(cuid())
  donationId                  String
  donation                    FoodDonation      @relation(fields: [donationId], references: [id], onDelete: Restrict)
  ngoId                       String
  ngo                         Organization      @relation(fields: [ngoId], references: [id], onDelete: Restrict)
  reservedById                String?
  reservedBy                  User?             @relation(fields: [reservedById], references: [id], onDelete: SetNull)
  status                      ReservationStatus @default(PENDING)
  pickupCode                  String?           @db.VarChar(10)
  pickupVerificationCode      String?           @db.VarChar(10)
  pickupVerificationExpiresAt DateTime?
  pickupVerifiedAt            DateTime?
  notes                       String?           @db.Text
  reservedAt                  DateTime          @default(now())
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  deletedAt                   DateTime?

  @@index([ngoId])
  @@index([donationId])
  @@index([status])
  @@index([deletedAt])
}
